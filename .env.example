# Copia a .env y rellena. Nunca subas .env a git.
# Secretos aleatorios:  openssl rand -hex 24
# No pongas comentarios en la misma línea que un valor.

# --- Servidor ---
DOMINIO=bots.tudominio.com

# --- Base de datos: Supabase > Connect > "Session pooler" (puerto 5432) ---
DATABASE_URL=postgresql://postgres.xxxxxxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Panel de administración (HTTP Basic sobre HTTPS). Clave de 12+ caracteres ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- WhatsApp Cloud API (Meta) ---
# WA_VERIFY_TOKEN: lo inventas tú; el mismo valor va en Meta al configurar el webhook
WA_VERIFY_TOKEN=
# WA_APP_SECRET: Meta > Configuración de la app > Básica > Clave secreta
WA_APP_SECRET=
# WA_ACCESS_TOKEN: token PERMANENTE de un usuario del sistema (no el temporal de 24 h)
WA_ACCESS_TOKEN=
GRAPH_VERSION=v23.0

# --- IA ---
ANTHROPIC_API_KEY=
# Opus 5.5 por defecto (máxima calidad). Para bajar el costo ~40x en chats simples: claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# --- Opcionales ---
# POST firmado (X-Signature: sha256=HMAC del cuerpo) al aprobar una solicitud y al escalar una conversación
EVENTS_WEBHOOK_URL=
EVENTS_WEBHOOK_SECRET=
ZONA_HORARIA=America/Mexico_City
# Minutos que el bot calla tras pasar a un humano
PAUSA_MINUTOS=30
# Tope de mensajes entrantes por conversación y hora: protege el gasto en la API
MAX_MSGS_HORA=30
# Mensajes previos que ve el modelo
HISTORIAL=20
